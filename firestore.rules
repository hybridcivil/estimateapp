rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'client', 'location', 'engineer', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.client is string && data.client.size() <= 200
        && data.location is string && data.location.size() <= 200
        && data.engineer is string && data.engineer.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('stories' in data) || (data.stories is number && data.stories >= 1 && data.stories <= 200))
        && (!('estimates' in data) || data.estimates is list)
        && (!('rates' in data) || data.rates is map);
    }

    // Connection testing endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;
      allow create: if isValidId(projectId)
                    && incoming().id == projectId
                    && isValidProject(incoming());
      allow update: if isValidId(projectId)
                    && isValidProject(incoming())
                    && incoming().id == existing().id
                    && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(projectId);
    }
  }
}
