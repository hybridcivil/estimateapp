rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    // Role-Based Access Control: Checks designated /admins collection or bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "engrkalilinux@gmail.com"
      );
    }

    // Entity Validation Helpers
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'client', 'location', 'engineer', 'ownerId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.client is string && data.client.size() <= 200
        && data.location is string && data.location.size() <= 200
        && data.engineer is string && data.engineer.size() <= 200
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('stories' in data) || (data.stories is number && data.stories >= 1 && data.stories <= 200))
        && (!('estimates' in data) || data.estimates is list)
        && (!('rates' in data) || data.rates is map);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.role is string && (data.role == 'admin' || data.role == 'engineer')
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    // Connection testing endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // User Accounts collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId)
                    && request.auth.uid == userId
                    && incoming().uid == userId
                    && isValidUser(incoming())
                    && (incoming().role == 'engineer' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isSignedIn() && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && (
                      isAdmin() ||
                      (request.auth.uid == userId
                       && incoming().role == existing().role
                       && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt']))
                    );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admin List collection
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }

    // Projects collection: User-owned with full Admin supervisory control
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId)
                 && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
                  && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if isVerified() && isValidId(projectId)
                    && incoming().id == projectId
                    && incoming().ownerId == request.auth.uid
                    && isValidProject(incoming());

      allow update: if isVerified() && isValidId(projectId)
                    && isValidProject(incoming())
                    && incoming().id == existing().id
                    && incoming().ownerId == existing().ownerId
                    && incoming().createdAt == existing().createdAt
                    && (existing().ownerId == request.auth.uid || isAdmin());

      allow delete: if isSignedIn() && isValidId(projectId)
                    && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
