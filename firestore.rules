rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    // Role-Based Access Control: Checks designated /admins collection or bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "engrkalilinux@gmail.com"
      );
    }

    // Entity Validation Helpers
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'client', 'location', 'engineer', 'ownerId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.client is string && data.client.size() <= 200
        && data.location is string && data.location.size() <= 200
        && data.engineer is string && data.engineer.size() <= 200
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 200))
        && (!('assignedTo' in data) || data.assignedTo == null || (data.assignedTo is string && data.assignedTo.size() <= 128))
        && (!('assignedToEmail' in data) || data.assignedToEmail == null || (data.assignedToEmail is string && data.assignedToEmail.size() <= 200))
        && (!('assignedToName' in data) || data.assignedToName == null || (data.assignedToName is string && data.assignedToName.size() <= 200))
        && (!('assignedUserIds' in data) || data.assignedUserIds is list)
        && (!('assignedUserEmails' in data) || data.assignedUserEmails is list)
        && (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 100))
        && (!('assignedBy' in data) || (data.assignedBy is string && data.assignedBy.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('stories' in data) || (data.stories is number && data.stories >= 1 && data.stories <= 200))
        && (!('totalCost' in data) || (data.totalCost is number && data.totalCost >= 0))
        && (!('estimates' in data) || data.estimates is list)
        && (!('rates' in data) || data.rates is map);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.role is string && (data.role == 'admin' || data.role == 'editor' || data.role == 'viewer' || data.role == 'engineer')
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('authProvider' in data) || data.authProvider == null || (data.authProvider is string && data.authProvider.size() <= 50))
        && (!('password' in data) || data.password == null || (data.password is string && data.password.size() <= 200));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    function isValidServiceVoucher(data) {
      return data.keys().hasAll(['id', 'voucherNo', 'date', 'clientName', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.voucherNo is string && data.voucherNo.size() > 0 && data.voucherNo.size() <= 100
        && data.date is string && data.date.size() <= 50
        && data.clientName is string && data.clientName.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 100))
        && (!('projectName' in data) || (data.projectName is string && data.projectName.size() <= 200))
        && (!('projectId' in data) || data.projectId == null || (data.projectId is string && data.projectId.size() <= 128))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('items' in data) || data.items is list)
        && (!('subtotal' in data) || data.subtotal is number)
        && (!('discount' in data) || data.discount is number)
        && (!('netTotal' in data) || data.netTotal is number)
        && (!('paid' in data) || data.paid is number)
        && (!('due' in data) || data.due is number)
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus.size() <= 50))
        && (!('ownerId' in data) || data.ownerId == null || (data.ownerId is string && data.ownerId.size() <= 128))
        && (!('ownerEmail' in data) || data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && (!('terms' in data) || (data.terms is string && data.terms.size() <= 3000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && (!('companyName' in data) || data.companyName == null || (data.companyName is string && data.companyName.size() <= 200))
        && (!('companyTagline' in data) || data.companyTagline == null || (data.companyTagline is string && data.companyTagline.size() <= 200))
        && (!('companyServices' in data) || data.companyServices == null || (data.companyServices is string && data.companyServices.size() <= 500))
        && (!('companyContact' in data) || data.companyContact == null || (data.companyContact is string && data.companyContact.size() <= 300));
    }

    // Connection testing endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // User Accounts collection
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(userId)
                    && incoming().uid == userId
                    && isValidUser(incoming())
                    && (incoming().role == 'engineer' || incoming().role == 'editor' || incoming().role == 'viewer' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && (
                      isAdmin() ||
                      incoming().role == existing().role
                    );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admin List collection
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }

    // Projects collection: User-owned with full Admin supervisory control
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidId(projectId)
                    && incoming().id == projectId
                    && isValidProject(incoming());
      allow update: if isValidId(projectId)
                    && isValidProject(incoming())
                    && incoming().id == existing().id;
      allow delete: if isValidId(projectId);
    }

    // Service Vouchers & Consultancy Invoices collection (Strictly Confidential Per User)
    match /service_vouchers/{voucherId} {
      allow get: if !isSignedIn() ||
                    existing().ownerId == request.auth.uid ||
                    (request.auth.token.email != null && existing().ownerEmail == request.auth.token.email) ||
                    isAdmin();
      allow list: if !isSignedIn() ||
                    resource.data.ownerId == request.auth.uid ||
                    (request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email) ||
                    isAdmin();
      allow create: if isValidId(voucherId)
                    && incoming().id == voucherId
                    && isValidServiceVoucher(incoming())
                    && (
                      !isSignedIn() ||
                      incoming().ownerId == request.auth.uid ||
                      (request.auth.token.email != null && incoming().ownerEmail == request.auth.token.email) ||
                      isAdmin()
                    );
      allow update: if isValidId(voucherId)
                    && isValidServiceVoucher(incoming())
                    && incoming().id == existing().id
                    && (
                      !isSignedIn() ||
                      existing().ownerId == request.auth.uid ||
                      (request.auth.token.email != null && existing().ownerEmail == request.auth.token.email) ||
                      isAdmin()
                    );
      allow delete: if isValidId(voucherId)
                    && (
                      !isSignedIn() ||
                      existing().ownerId == request.auth.uid ||
                      (request.auth.token.email != null && existing().ownerEmail == request.auth.token.email) ||
                      isAdmin()
                    );
    }
  }
}
