{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Civil engineering project and estimation file container owned by an engineer",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Project title or building name",
          "maxLength": 200
        },
        "client": {
          "type": "string",
          "description": "Client or developer name",
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "description": "Project site location",
          "maxLength": 200
        },
        "engineer": {
          "type": "string",
          "description": "Lead engineer or estimator",
          "maxLength": 200
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner",
          "maxLength": 128
        },
        "ownerEmail": {
          "type": "string",
          "description": "Email address of the project owner",
          "maxLength": 200
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the project owner",
          "maxLength": 200
        },
        "assignedTo": {
          "type": "string",
          "description": "UID of engineer assigned by admin to edit project",
          "maxLength": 128
        },
        "assignedToEmail": {
          "type": "string",
          "description": "Email of engineer assigned by admin to edit project",
          "maxLength": 200
        },
        "assignedToName": {
          "type": "string",
          "description": "Name of engineer assigned by admin to edit project",
          "maxLength": 200
        },
        "assignedUserIds": {
          "type": "array",
          "description": "Array of user UIDs assigned by admin to edit project"
        },
        "assignedUserEmails": {
          "type": "array",
          "description": "Array of user emails assigned by admin to edit project"
        },
        "assignedAt": {
          "type": "string",
          "description": "ISO timestamp when project was assigned by admin"
        },
        "assignedBy": {
          "type": "string",
          "description": "Email or UID of admin who assigned the project",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "description": "Project notes or specifications",
          "maxLength": 2000
        },
        "stories": {
          "type": "number",
          "description": "Number of storeys or floors in the building"
        },
        "rates": {
          "type": "object",
          "description": "Unified global material rates set once for the whole project"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "estimates": {
          "type": "array",
          "description": "List of saved structural and civil estimate items"
        }
      },
      "required": ["id", "name", "client", "location", "engineer", "ownerId", "createdAt", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role assignment",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User Google email address",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 1000
        },
        "role": {
          "type": "string",
          "description": "Access control role: admin, editor, or viewer",
          "enum": ["admin", "editor", "viewer", "engineer"]
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login timestamp"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator identity record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase UID of designated administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 200
        },
        "grantedAt": {
          "type": "string",
          "description": "ISO timestamp when admin role was granted"
        }
      },
      "required": ["uid", "email"]
    },
    "ServiceVoucher": {
      "title": "ServiceVoucher",
      "description": "Engineering consultancy and civil service voucher, billing invoice, and payment tracking record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique voucher identifier",
          "maxLength": 128
        },
        "voucherNo": {
          "type": "string",
          "description": "Sequential or formatted voucher number (e.g., HC-2026-001)",
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "description": "ISO date string of voucher issue"
        },
        "clientName": {
          "type": "string",
          "description": "Client or company name",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "description": "Client contact phone number",
          "maxLength": 50
        },
        "projectName": {
          "type": "string",
          "description": "Project or building name",
          "maxLength": 200
        },
        "projectId": {
          "type": "string",
          "description": "Optional linked project ID in Ashraf Civil Studio",
          "maxLength": 128
        },
        "address": {
          "type": "string",
          "description": "Project site or client address",
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "description": "List of engineering consultancy services, quantities, rates, and line totals"
        },
        "subtotal": {
          "type": "number",
          "description": "Gross subtotal before discount"
        },
        "discount": {
          "type": "number",
          "description": "Discount amount in BDT"
        },
        "netTotal": {
          "type": "number",
          "description": "Net payable amount after discount"
        },
        "paid": {
          "type": "number",
          "description": "Advance or received payment in BDT"
        },
        "due": {
          "type": "number",
          "description": "Outstanding balance due in BDT"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method (Cash, bKash, Nagad, Bank Transfer, Cheque)",
          "maxLength": 50
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status (Paid, Partial, Due)",
          "maxLength": 50
        },
        "ownerId": {
          "type": "string",
          "description": "UID of engineer who created the voucher",
          "maxLength": 128
        },
        "ownerEmail": {
          "type": "string",
          "description": "Email of engineer who created the voucher",
          "maxLength": 200
        },
        "terms": {
          "type": "string",
          "description": "Customizable terms and conditions note",
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or remarks",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "voucherNo", "date", "clientName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of civil engineering projects and estimate records owned by users"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records containing account info and roles"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin collection listing trusted user IDs with global management rights"
    },
    "/service_vouchers/{voucherId}": {
      "schema": "ServiceVoucher",
      "description": "Collection of engineering consultancy service vouchers and billing invoices strictly isolated and confidential per user"
    }
  }
}
